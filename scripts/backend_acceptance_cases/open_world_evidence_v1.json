{
  "schema_version": 1,
  "case_id": "open-world-evidence-v1",
  "scenario_ids": ["S2"],
  "operation_mode": "participatory",
  "creator_brief": "创作一部紧凑的单故事弧悬疑短篇。主角许澜在档案馆调查“蓝灯事件”。前文没有写过某件普通事情，不代表那件事被否定；只有正式正文中的明确相反事实才构成冲突。请规划一个故事弧，并让第一章自然建立这一事实：许澜直到当前场景才第一次把蓝灯事件写进自己的纸质工作日志。不要为了证明过去没有记录而补写不自然的否定句，也不要要求改写更早的正式历史。章节数只是建议，Book 规划 Arc，Arc 规划 Chapter。",
  "terminal": "first_chapter_committed",
  "restart_after_first_chapter": false,
  "maximum_minutes": 75,
  "maximum_agent_tasks": 32,
  "required_task_kinds": [
    "book.discuss",
    "book.synthesize",
    "evaluate.book",
    "arc.plan",
    "evaluate.arc",
    "chapter.plan",
    "chapter.draft",
    "chapter.observe",
    "evaluate.chapter"
  ],
  "required_event_types": [
    "book.baseline_committed",
    "arc.baseline_committed",
    "chapter.baseline_committed"
  ],
  "forbidden_event_types": [
    "change_request.opened"
  ]
}

{
  "schema_version": 1,
  "case_id": "derived-evidence-v1",
  "scenario_ids": ["S3"],
  "operation_mode": "participatory",
  "creator_brief": "创作一部紧凑的单故事弧档案悬疑短篇。全书稳定承诺：主角许澜保护原始档案，不销毁、不伪造。故事弧第一章必须通过可观察行动明确表现她把一份受潮原件封存进蓝色恒温柜，并登记封存编号；这不是销毁原件。Observation 与 Canon 只能从正式正文派生，如果派生记录误把封存概括成销毁，应纠正派生记录而不是反向改写正确正文。请用一个故事弧完成最小闭环，Book 规划 Arc，Arc 规划 Chapter。",
  "terminal": "first_chapter_committed",
  "restart_after_first_chapter": false,
  "maximum_minutes": 75,
  "maximum_agent_tasks": 36,
  "required_task_kinds": [
    "book.discuss",
    "book.synthesize",
    "evaluate.book",
    "arc.plan",
    "evaluate.arc",
    "chapter.plan",
    "chapter.draft",
    "chapter.observe",
    "evaluate.chapter"
  ],
  "required_event_types": [
    "book.baseline_committed",
    "arc.baseline_committed",
    "chapter.baseline_committed",
    "canon.baseline_committed"
  ],
  "preserve_prose_when_evidence_only_repair_occurs": true
}

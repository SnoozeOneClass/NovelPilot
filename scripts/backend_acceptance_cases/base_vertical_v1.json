{
  "schema_version": 1,
  "case_id": "base-vertical-v1",
  "scenario_ids": ["S1", "S5"],
  "operation_mode": "participatory",
  "creator_brief": "创作一部紧凑的单故事弧悬疑短篇，用于验证从全书规划到正式章节提交的完整链路。主角许澜是市档案馆修复师，她在闭馆夜发现一份被错误归档的旧录音，并通过保存、核验和公开原始证据解决核心谜团。全书稳定承诺：许澜不会销毁、伪造或偷换任何原始档案。请将这次短篇规划为一个完整故事弧；故事弧用一章完成发现、核验与公开的闭环。章节数只是紧凑性建议，Book 只负责故事弧拓扑，Arc 负责章节大纲。",
  "terminal": "continued_after_restart",
  "restart_after_first_chapter": true,
  "maximum_minutes": 90,
  "maximum_agent_tasks": 40,
  "required_task_kinds": [
    "book.discuss",
    "book.synthesize",
    "evaluate.book",
    "arc.plan",
    "evaluate.arc",
    "chapter.plan",
    "chapter.draft",
    "chapter.observe",
    "evaluate.chapter"
  ],
  "required_event_types": [
    "book.baseline_committed",
    "arc.baseline_committed",
    "chapter.baseline_committed"
  ]
}
